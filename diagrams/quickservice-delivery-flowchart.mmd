%% QuickService Delivery — Order Management Process Flowchart
%% Author: Rodrigo Garza García
%% Tool: Mermaid (source) / Lucidchart (visual diagram)

flowchart TD
    A([Start]) --> B[Customer places order]
    B --> C[Receive and record order details<br/>Customer Service]
    C --> D{Order complete?}
    D -- No --> E[Request missing information<br/>Customer Service]
    E --> F[Customer provides missing information]
    F --> C
    D -- Yes --> G[Confirm order details<br/>Customer Service]
    G --> H[Provide payment options<br/>Sales]
    H --> I[Submit / retry payment<br/>Customer]
    I --> J[Verify payment receipt<br/>Sales]
    J --> K{Payment received?}
    K -- No --> L[Notify customer and request payment<br/>Sales]
    L --> I
    K -- Yes --> M[Prepare order to customer requirements<br/>Production]
    M --> N{Order ready?}
    N -- No --> O[Complete preparation / resolve issue<br/>Production]
    O --> N
    N -- Yes --> P{Fulfillment method?}
    P -- Pickup --> Q[Prepare order and notify customer<br/>Warehouse - Pickup]
    P -- Home Delivery --> R[Schedule and dispatch delivery<br/>Warehouse - Home delivery]
    Q --> S[Customer collects or receives order]
    R --> S
    S --> T([End])
